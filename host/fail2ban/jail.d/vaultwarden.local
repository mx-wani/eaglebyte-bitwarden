# Bans are added to the DOCKER-USER chain because traffic to Coolify's proxy
# is forwarded into a container and never reaches the host's INPUT chain.
# logpath globs the Coolify-managed volume (<resource-uuid>_vaultwarden-data).

[vaultwarden]
enabled   = true
filter    = vaultwarden
logpath   = /var/lib/docker/volumes/*_vaultwarden-data/_data/vaultwarden.log
banaction = iptables-allports
chain     = DOCKER-USER
maxretry  = 5
findtime  = 15m
bantime   = 4h

[vaultwarden-admin]
enabled   = true
filter    = vaultwarden-admin
logpath   = /var/lib/docker/volumes/*_vaultwarden-data/_data/vaultwarden.log
banaction = iptables-allports
chain     = DOCKER-USER
maxretry  = 3
findtime  = 15m
bantime   = 24h
