# Copy to .env (scripts/setup.sh does this for you) and keep it out of git.
# Full option list: https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

# --- Required ---------------------------------------------------------------
# Public URL of the vault, scheme included. Caddy requests a certificate for this host.
DOMAIN=https://vault.mxwani.cloud
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# Pinned image versions. Bump deliberately, then run scripts/update.sh.
VW_VERSION=1.37.4
CADDY_VERSION=2.11.7

TZ=UTC

# --- Admin panel (https://vault.mxwani.cloud/admin) ---------------------------
# Argon2id hash written by scripts/setup.sh. Keep the single quotes: the hash
# contains '$' characters that docker compose would otherwise interpolate.
ADMIN_TOKEN=''

# --- Accounts ---------------------------------------------------------------
# Public sign-up stays off; invite people from the admin panel instead.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=EagleByte Vault
SHOW_PASSWORD_HINT=false

# --- Email (invitations, email 2FA, new-device alerts) ----------------------
# SMTP_HOST=smtp.example.com
# SMTP_FROM=vault@mxwani.cloud
# SMTP_FROM_NAME=EagleByte Vault
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Mobile push notifications ----------------------------------------------
# Request an installation ID and key at https://bitwarden.com/host/
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
# Only if you picked the EU data region on that page:
# PUSH_RELAY_URI=https://api.bitwarden.eu
# PUSH_IDENTITY_URI=https://identity.bitwarden.eu

# --- Backups (scripts/backup.sh) --------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Optional off-site copy with rclone, e.g. b2:eaglebyte-backups/vaultwarden
# BACKUP_RCLONE_REMOTE=
